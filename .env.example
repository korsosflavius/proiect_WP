# Copiati acest fisier in .env si adaptati.
# SQL Server cu autentificare Windows (instanta SQLEXPRESS cu TCP activ pe portul 1433):
DATABASE_URL="sqlserver://localhost:1433;database=wedcraft;integratedSecurity=true;trustServerCertificate=true"
# SQL Server cu utilizator SQL:
# DATABASE_URL="sqlserver://localhost:1433;database=wedcraft;user=sa;password=PAROLA;trustServerCertificate=true"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genereaza-un-secret-lung"
